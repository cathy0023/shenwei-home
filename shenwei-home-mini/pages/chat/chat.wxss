/* 聊天页样式：对齐 design/preview.html @v0.1（深青渐变 + 圆角气泡）。 */
.chat-scroll {
  flex: 1;
  height: 0;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #CDEFEA 0%, #E7F6F4 480rpx, rgba(231, 246, 244, 0) 840rpx);
  box-sizing: border-box;
}

.pull-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 12rpx 0 28rpx;
  color: #9AB5BE;
  font-size: 24rpx;
  letter-spacing: 0.08em;
}

/* ---------- Hero ---------- */
.hero {
  position: relative;
  border-radius: var(--radius-lg);
  padding: 52rpx 44rpx 64rpx;
  background:
    radial-gradient(680rpx 400rpx at 88% -20%, rgba(94, 234, 212, 0.55), transparent 60%),
    radial-gradient(600rpx 440rpx at -10% 120%, rgba(14, 165, 233, 0.35), transparent 55%),
    linear-gradient(150deg, #0E7D8F 0%, #12A5A5 55%, #2CC7B4 100%);
  color: #fff;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(11, 100, 119, 0.16);
}
.hero-hello {
  font-weight: 900;
  font-size: 76rpx;
  line-height: 1.05;
  background: linear-gradient(100deg, #B9F7EE 10%, #7DE9FF 90%);
  -webkit-background-clip: text;
  color: transparent;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #E8FBF8;
}
.hero-sub .hl {
  color: #FFE5A3;
  border-bottom: 4rpx solid rgba(255, 229, 163, 0.6);
  padding-bottom: 2rpx;
}
/* ---------- 纯元素机器人（Hero 大版 + 消息头像迷你版共用比例） ---------- */
/* hero 版：1em = 10rpx；头像版：avatar 容器 font-size 决定缩放 */
.mascot-css {
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  width: 220rpx;
  height: 250rpx;
  font-size: 10rpx;
  animation: botFloat 3.6s ease-in-out infinite;
}
@keyframes botFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.bot-antenna {
  position: absolute;
  top: -8rpx;
  left: 50%;
  margin-left: -2rpx;
  width: 4rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 2rpx;
}
.bot-antenna::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFE5A3;
  box-shadow: 0 0 8rpx rgba(255, 229, 163, 0.8);
}
.bot-head {
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 150rpx;
  height: 130rpx;
  background: #FFFFFF;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 24rpx rgba(8, 74, 92, 0.25);
}
/* 耳机：头带弧 + 双层圆形耳罩（弧端精准落在耳罩中心；明亮蓝青配色） */
/* 几何：头带宽150(半宽75)，耳罩中心 x=±74 / y=67 → 弧半径74、弧底 y=67 */
.bot-band {
  position: absolute;
  top: -13rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 148rpx;
  height: 80rpx;
  border: 12rpx solid #3FA8C9;
  border-bottom: none;
  border-radius: 74rpx 74rpx 0 0;
}
.bot-ear {
  position: absolute;
  top: 44rpx;
  width: 34rpx;
  height: 46rpx;
  border-radius: 16rpx;
  background: #3FA8C9;
  box-shadow: inset 0 -4rpx 8rpx rgba(0, 60, 80, 0.18), 0 4rpx 10rpx rgba(8, 74, 92, 0.25);
}
.bot-ear.left { left: -19rpx; }
.bot-ear.right { right: -19rpx; }
/* 耳罩内芯：薄荷绿椭圆 + 顶部高光 */
.bot-ear::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 28rpx;
  border-radius: 9rpx;
  background: #8FF0E0;
}
.bot-ear::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  z-index: 1;
}
.bot-visor {
  position: absolute;
  top: 26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 112rpx;
  height: 76rpx;
  background: #0B6477;
  border-radius: 34rpx;
  overflow: hidden;
}
.bot-eye {
  position: absolute;
  top: 24rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5EEAD4;
}
.bot-eye.left { left: 28rpx; }
.bot-eye.right { right: 28rpx; }
.bot-mouth {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  margin-left: -14rpx;
  width: 28rpx;
  height: 14rpx;
  border: 4rpx solid #5EEAD4;
  border-top: none;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 0 0 20rpx 20rpx;
}
.bot-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 110rpx;
  height: 90rpx;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 26rpx 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(8, 74, 92, 0.25);
}
.bot-chest {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 40rpx;
  background: #D9F6F1;
  border-radius: 14rpx;
}
.bot-chest::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 10rpx;
  width: 22rpx;
  height: 14rpx;
  border: 5rpx solid #14B8A6;
  border-top: none;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 0 0 12rpx 12rpx;
}

/* ---------- 头像迷你版（复用比例：容器 76rpx，内容按 76/76 缩放绘制） ---------- */
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(140deg, #FFFFFF, #E9FDFA);
  box-shadow: 0 4rpx 10rpx rgba(11, 100, 119, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.bot-mini {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}
.bot-mini-visor {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 34rpx;
  background: #0B6477;
  border-radius: 16rpx;
}
.bot-mini-eye {
  position: absolute;
  top: 11rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #5EEAD4;
}
.bot-mini-eye.left { left: 11rpx; }
.bot-mini-eye.right { right: 11rpx; }
.bot-mini-mouth {
  position: absolute;
  bottom: 7rpx;
  left: 50%;
  margin-left: -7rpx;
  width: 14rpx;
  height: 7rpx;
  border: 2.5rpx solid #5EEAD4;
  border-top: none;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 0 0 10rpx 10rpx;
}

/* ---------- 推荐问题 ---------- */
.suggest {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 36rpx 36rpx 16rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 36rpx;
}
.suggest-title {
  font-size: 26rpx;
  color: var(--ink-soft);
  font-weight: 600;
  letter-spacing: 0.05em;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.suggest-title::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--teal-500);
  box-shadow: 0 0 0 6rpx rgba(20, 184, 166, 0.18);
}
.suggest-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #EFF4F5;
  font-size: 30rpx;
  color: var(--ink);
}
.suggest-item:last-child { border-bottom: none; }
.suggest-item .sparkle { color: var(--teal-500); }
.suggest-item .suggest-text { flex: 1; }
.suggest-item .chev { color: #C3D4D9; font-size: 34rpx; }
.suggest-item:active { background: #E4F6F3; }

/* ---------- 消息气泡 ---------- */
.msg { margin: 28rpx 0; }
.msg.user .msg-row { flex-direction: row-reverse; }
.msg-row { display: flex; gap: 20rpx; align-items: flex-start; }
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, #E9FDFA, #C9F3EC);
  box-shadow: 0 4rpx 10rpx rgba(11, 100, 119, 0.15);
  flex-shrink: 0;
}
.bubble {
  max-width: 72%;
  padding: 24rpx 30rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  line-height: 1.65;
  background: var(--card);
  box-shadow: var(--shadow-soft);
  border-top-left-radius: 12rpx;
  word-break: break-all;
  position: relative;
}
.bubble.mine {
  background: linear-gradient(135deg, #14B8A6, #0EA5E9);
  color: #fff;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.35);
}
/* 人工客服头像：同款浅底 + 琥珀人形图标（SVG path 经 CSS mask 渲染，小程序不直接支持内联 svg） */
.human-mini {
  width: 40rpx;
  height: 40rpx;
  background: #F0B429;
  -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M4 22C4 17.5817 7.58172 14 12 14C16.4183 14 20 17.5817 20 22H18C18 18.6863 15.3137 16 12 16C8.68629 16 6 18.6863 6 22H4ZM12 13C8.685 13 6 10.315 6 7C6 3.685 8.685 1 12 1C15.315 1 18 3.685 18 7C18 10.315 15.315 13 12 13ZM12 11C14.21 11 16 9.21 16 7C16 4.79 14.21 3 12 3C9.79 3 8 4.79 8 7C8 9.21 9.79 11 12 11Z'/></svg>");
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

/* 人工回复：气泡右上角迷你金标（轻量区分，气泡本体不变） */
.human-corner-tag {
  position: absolute;
  top: -14rpx;
  right: 12rpx;
  padding: 1rpx 10rpx;
  border-radius: 999rpx;
  background: #F5C242;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.5;
  box-shadow: 0 2rpx 6rpx rgba(245, 194, 66, 0.35);
}
.bubble .pic {
  /* widthFix 需要非零基准宽：气泡由内容撑开，图片未加载时 100% 会解析为 0 → 永不渲染 */
  width: 360rpx;
  max-width: 100%;
  border-radius: 24rpx;
  display: block;
}
/* 图片消息气泡：裸展示——去内边距/背景/阴影，不叠加任何视觉效果 */
.pic-bubble {
  padding: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  overflow: hidden;
}
/* 图片加载失败占位 */
.pic-fallback {
  width: 360rpx;
  max-width: 100%;
  height: 220rpx;
  border-radius: 24rpx;
  background: #EEF4F5;
  border: 2rpx dashed #C9DADD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.pic-fallback-icon {
  font-size: 44rpx;
  opacity: 0.55;
}
.pic-fallback-text {
  font-size: 22rpx;
  color: #9AB5BE;
}
.fail-mark {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #EF4444;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 36rpx;
}
.sys-tip {
  margin: 28rpx auto;
  max-width: 80%;
  text-align: center;
  font-size: 25rpx;
  color: var(--deep-700);
  background: rgba(20, 184, 166, 0.10);
  border: 1rpx dashed rgba(20, 184, 166, 0.4);
  padding: 18rpx 28rpx;
  border-radius: 28rpx;
}

.scroll-spacer { height: 24rpx; }

/* ---------- 快捷操作条 ---------- */
.quickbar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 8rpx;
}
.chip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 3rpx solid #D8EBEA;
  color: var(--deep-700);
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 3rpx 10rpx rgba(11, 100, 119, 0.06);
}
.chip:active { transform: scale(0.95); }
.chip-done { border-color: var(--teal-500); color: var(--teal-600); background: #EFFCF9; }

/* ---------- 输入区 ---------- */
.inputzone { background: var(--bg); }
.inputbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 28rpx 20rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 14rpx 16rpx 14rpx 12rpx;
  box-shadow: 0 6rpx 22rpx rgba(11, 100, 119, 0.12);
  border: 3rpx solid #E2EFEE;
}
.icon-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7FA3AD;
  flex-shrink: 0;
  font-size: 40rpx;
}
.icon-btn.active { background: rgba(20, 184, 166, 0.14); color: var(--teal-600); }
.icon-btn:active { transform: scale(0.88); }
.input {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
  min-width: 0;
}
.send-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--teal-500), #0EA5E9);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(20, 184, 166, 0.4);
}
.send-btn.disabled { opacity: 0.35; box-shadow: none; }
.send-btn:active { transform: scale(0.9); }

/* ---------- 表情面板 ---------- */
.panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.32s ease;
  background: #fff;
}
.panel.open { max-height: 440rpx; box-shadow: 0 -8rpx 30rpx rgba(11, 100, 119, 0.10); }
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 28rpx 36rpx 36rpx;
}
.emoji-cell {
  width: 12.5%;
  text-align: center;
  font-size: 48rpx;
  padding: 10rpx 0;
  border-radius: 20rpx;
}
.emoji-cell:active { background: #EFF8F7; transform: scale(1.25); }

.home-indicator {
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.home-indicator::after {
  content: '';
  width: 260rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: #C9DADD;
}
