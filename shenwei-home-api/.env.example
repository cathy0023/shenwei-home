# 深维之家 — 外部智能回复服务对接配置（模板，复制为 .env 后填真实值）
# 协议：IM 渠道对接协议 v1（channel_type='external'）

CHANNEL_BASE_URL=https://demo.sop.mgvai.cn
CHANNEL_ENDPOINT_PREFIX=/api/v1/sop/im/external
CHANNEL_APP_KEY=your_app_key
CHANNEL_APP_SECRET=your_app_secret

# 出站推送回调地址（需公网 HTTPS；留空则仅 pull 消费）
CHANNEL_CALLBACK_URL=

# 微信小程序（后端 jscode2session 用）
WX_MINI_APPID=
WX_MINI_SECRET=
